generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Channel {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  slots       ScheduleSlot[]
  rulesetBindings ChannelRuleset[]
}

model ScheduleSlot {
  id          String   @id @default(cuid())
  
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  mediaAssetId  String?
  mediaAsset    MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  startsAt    DateTime
  endsAt      DateTime
  title       String
  description String?

  origin      String   @default("manual") // manual | engine | override
  ruleId      String?
  rule        Rule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)  
 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([channelId, startsAt])
  @@index([mediaAssetId])
  @@index([ruleId])
}

/// Catalog knowledge about a title (movie, episode, etc.).
/// Distinct from MediaAsset, which is a playable file or stream.
model Work {
  id           String   @id @default(cuid())
  title        String

  /// movie | episode | series | other  (free-form string for now)
  kind         String   @default("movie")

  year         Int?
  genre        String?
  synopsis     String?
  seriesTitle  String?
  season       Int?
  episode      Int?

  /// Future TMDB / IMDb / TVDB ids, NFO leftovers, etc.
  externalIds  Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assets       MediaAsset[]

  @@index([title, year])
}

model MediaAsset {
  id          String   @id @default(cuid())
  title       String
  
  /// Path or URL the player/proxy will eventually use
  /// Unique so NAS ingest can upsert idempotently by path.
  sourceUrl   String  @unique

  /// file | http-live | hls  (keep free-form string for now)
  sourceType  String   @default("file")

  durationSec Int?
  description String?

  needsVpn    Boolean  @default(false)
  vpnCountry  String?

  workId      String?
  work        Work?    @relation(fields: [workId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots       ScheduleSlot[]

  @@index([workId])
}

model Ruleset {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  /// sequential | first-match  (only sequential is implemented)
  applyMode   String   @default("sequential")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules       Rule[]
  channels    ChannelRuleset[]
}

model Rule {
  id            String   @id @default(cuid())
  rulesetId     String
  ruleset       Ruleset  @relation(fields: [rulesetId], references: [id], onDelete: Cascade)

  name          String
  /// rotate-series | no-repeat-episode | catalog-allowlist | llm | suggest
  kind          String
  /// local = this ruleset/channel; global = applies across channels unless skipped
  scope         String   @default("local")
  /// When false, this local rule may ignore global constraints (theme weekend).
  honorGlobals  Boolean  @default(true)
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0)
  payload       Json

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  slots         ScheduleSlot[]

  @@index([rulesetId, sortOrder])
}

model ChannelRuleset {
  id         String   @id @default(cuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  rulesetId  String
  ruleset    Ruleset  @relation(fields: [rulesetId], references: [id], onDelete: Cascade)

  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  startsAt   DateTime?
  endsAt     DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([channelId, rulesetId])
  @@index([channelId, isActive])
}