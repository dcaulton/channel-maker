generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Channel {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  slots       ScheduleSlot[]
}

model ScheduleSlot {
  id          String   @id @default(cuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  title       String
  description String?
  // We'll expand this later (media item, live source, rules, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([channelId, startsAt])
}
