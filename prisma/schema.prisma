generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Channel {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  slots       ScheduleSlot[]
}

model ScheduleSlot {
  id          String   @id @default(cuid())
  
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  mediaAssetId  String?
  mediaAsset    MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  startsAt    DateTime
  endsAt      DateTime
  title       String
  description String?
 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([channelId, startsAt])
  @@index([mediaAssetId])
}

model MediaAsset {
  id          String   @id @default(cuid())
  title       String
  /// Path or URL the player/proxy will eventually use
  sourceUrl   String
  /// file | http-live | hls  (keep free-form string for now)
  sourceType  String   @default("file")
  durationSec Int?
  description String?

  needsVpn    Boolean  @default(false)
  vpnCountry  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots       ScheduleSlot[]
}