generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Channel {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  slots       ScheduleSlot[]
}

model ScheduleSlot {
  id          String   @id @default(cuid())
  
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  mediaAssetId  String?
  mediaAsset    MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  startsAt    DateTime
  endsAt      DateTime
  title       String
  description String?
 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([channelId, startsAt])
  @@index([mediaAssetId])
}

/// Catalog knowledge about a title (movie, episode, etc.).
/// Distinct from MediaAsset, which is a playable file or stream.
model Work {
  id           String   @id @default(cuid())
  title        String

  /// movie | episode | series | other  (free-form string for now)
  kind         String   @default("movie")

  year         Int?
  genre        String?
  synopsis     String?
  seriesTitle  String?
  season       Int?
  episode      Int?

  /// Future TMDB / IMDb / TVDB ids, NFO leftovers, etc.
  externalIds  Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assets       MediaAsset[]

  @@index([title, year])
}

model MediaAsset {
  id          String   @id @default(cuid())
  title       String
  
  /// Path or URL the player/proxy will eventually use
  /// Unique so NAS ingest can upsert idempotently by path.
  sourceUrl   String  @unique

  /// file | http-live | hls  (keep free-form string for now)
  sourceType  String   @default("file")

  durationSec Int?
  description String?

  needsVpn    Boolean  @default(false)
  vpnCountry  String?

  workId      String?
  work        Work?    @relation(fields: [workId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots       ScheduleSlot[]

  @@index([workId])
}